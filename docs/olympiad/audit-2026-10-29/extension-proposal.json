        },
        {
          "id": "s2",
          "depends_on": [
            "s1"
          ],
          "capability_id": "ext.olymp.nt.remainders",
          "claim": "在给定区间内候选为102、137、172、207、242。"
        },
        {
          "id": "s3",
          "depends_on": [
            "s2"
          ],
          "capability_id": "ext.olymp.nt.remainders",
